# StudyFlow AI Production Environment Variables

# Backend Server Port
PORT=5000

# Allowed Frontend Origin for CORS (e.g. https://studyflow.vercel.app or http://localhost:5173 for dev)
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI & Database Name
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=studyflow

# JWT Authentication Secret Key (Required for production)
JWT_SECRET=your_super_secret_production_jwt_key_change_me

# Google Gemini API Key (Kept server-side for AI proxying)
GEMINI_API_KEY=your_google_gemini_api_key_here
